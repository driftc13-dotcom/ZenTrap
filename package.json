{
  "name": "zentrap",
  "version": "1.0.12",
  "description": "ZenTrap - Roblox launcher",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win",
    "test": "node --test"
  },
  "devDependencies": {
    "electron": "45.3.0",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "com.zentrap.app",
    "productName": "ZenTrap",
    "files": [
      "main.js",
      "preload.js",
      "core/**/*",
      "src/**/*",
      "assets/**/*"
    ],
    "win": {
      "icon": "assets/zentrap-icon.ico",
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "deleteAppDataOnUninstall": false,
      "installerIcon": "assets/zentrap-icon.ico",
      "uninstallerIcon": "assets/zentrap-icon.ico",
      "installerHeaderIcon": "assets/zentrap-icon.ico",
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "releaseType": "release"
      }
    ],
    "npmRebuild": false
  },
  "dependencies": {
    "electron-updater": "^6.8.11"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/driftc13-dotcom/ZenTrap.git"
  },
  "author": "ZenTrap"
}
